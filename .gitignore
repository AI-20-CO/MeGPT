# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =============================================================================
# Node.js / Next.js
# =============================================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# =============================================================================
# Python (backend)
# =============================================================================

# Virtual environment
backend/venv/
venv/
.venv/

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution
*.egg-info/
dist/
build/

# =============================================================================
# Environment & Secrets
# =============================================================================

# env files (keep .env.example for documentation)
.env
.env.local
.env.*.local
!.env.example
backend/.env
!backend/.env.example

# =============================================================================
# IDE & OS
# =============================================================================

.DS_Store
*.pem
.idea/
.vscode/
*.swp
*.swo

# vercel
.vercel
